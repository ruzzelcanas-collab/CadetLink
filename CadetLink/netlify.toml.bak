[build]
  publish = "."
  functions = "functions"

[[redirects]]
  from = "/"
  to = "/index.html"
  status = 302

[[redirects]]
  from = "/NmoHistorySync.gs"
  to = "/404.html"
  status = 404
  force = true

[[redirects]]
  from = "/RFID_Sketch/*"
  to = "/404.html"
  status = 404
  force = true
